# Optional: enables general-purpose AI answers in the Intelligence assistant.
# Without a key, ChurnIQ still provides deterministic answers from your customer data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional monitoring cadence
CHURNIQ_MONITOR_INTERVAL_SECONDS=3600
CHURNIQ_AUTO_REPORT_ENABLED=true
CHURNIQ_AUTO_REPORT_INTERVAL_SECONDS=86400
